{
  "name": "zhi-zhou",
  "version": "1.0.0",
  "private": true,
  "description": "Cat’s Library — AI 中文小说阅读站（基于 Novel-KV 全量重写：React + Hono + TypeScript）",
  "type": "module",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@zhi-zhou/web",
    "dev:api": "npm run dev --workspace=@zhi-zhou/api",
    "build": "npm run build --workspace=@zhi-zhou/web && npm run build --workspace=@zhi-zhou/api",
    "release:package": "node scripts/package-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "eval:agent": "tsx --tsconfig api/tsconfig.json api/scripts/evaluate-agent.ts",
    "eval:agent:check": "tsc -p api/scripts/tsconfig.evaluate-agent.json",
    "eval:agent:contract": "tsx --tsconfig api/tsconfig.json api/scripts/evaluate-agent-contract.ts",
    "eval:agent:review": "tsx --tsconfig api/tsconfig.json api/scripts/export-agent-review.ts",
    "review:agent:local": "tsx --tsconfig api/tsconfig.json api/scripts/agent-local-review.ts",
    "test:backup-integration": "node scripts/test-backup-integration.mjs",
    "test:reader-reliability": "node scripts/test-reader-reliability.mjs",
    "security:headers": "node scripts/export-browser-security-headers.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migrate": "npm run db:migrate --workspace=@zhi-zhou/api",
    "admin:recover": "tsx --tsconfig api/tsconfig.json api/scripts/recover-super-admin.ts",
    "backup:recover": "tsx --tsconfig api/tsconfig.json api/scripts/backup-recovery.ts",
    "start": "npm run start --workspace=@zhi-zhou/api"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
